# Optional pilot remains disabled unless explicitly set to true.
NEXT_PUBLIC_ALMANAC_ANALYTICS_ENABLED=false

# Analytics remain disabled when either variable is blank.
# Configure only after validating the destination, host region and consent policy.
# The project token is browser-public configuration; do not add secret API keys.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
