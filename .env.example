# Optional Almanac Netlify analytics pilot.
# This flag defaults off. Never set for production before release approval.
NEXT_PUBLIC_ALMANAC_ANALYTICS_ENABLED=false

# Public project token and ingestion host, blank unless approved for a
# branch-restricted preview. Never place PostHog personal/admin API keys here.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# The bot-detection test exception must only be enabled in CI with a fake
# intercepted PostHog endpoint. Never set it in Netlify environments.
NEXT_PUBLIC_ALMANAC_ANALYTICS_QA=false
