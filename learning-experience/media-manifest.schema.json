{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://almanac-study.example/schemas/media-manifest-v0.2.json",
  "title": "Almanac multimodal learning object manifest (proposal)",
  "description": "Experimental versioned content contract. NOT current database schema or an implemented media service. Shape validation only; trusted server must verify exact approval bindings, actual bytes, rights, fallback and entitlement independently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_id",
    "course_id",
    "objective_id",
    "objective",
    "topic_id",
    "status",
    "sources",
    "review",
    "variants",
    "assessments",
    "updated_at"
  ],
  "properties": {
    "object_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,119}$"
    },
    "course_id": {
      "type": "string",
      "minLength": 1
    },
    "topic_id": {
      "type": "string",
      "minLength": 1
    },
    "objective_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "audience": {
      "type": "string"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "foundational",
        "intermediate",
        "advanced"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "approved",
        "released",
        "superseded",
        "blocked"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "master_explanation": {
      "type": "string",
      "minLength": 15
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "name",
          "credibility",
          "rights"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "published_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "credibility": {
            "type": "string",
            "enum": [
              "verified",
              "pending",
              "rejected"
            ]
          },
          "rights": {
            "type": "string",
            "enum": [
              "owned_original",
              "permission_confirmed",
              "open_licensed",
              "link_only",
              "unverified",
              "prohibited"
            ]
          },
          "rights_evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_status",
        "media_status",
        "accessibility_status",
        "rights_status",
        "educational_hash"
      ],
      "properties": {
        "subject_status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "subject_reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "accessibility_status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "rights_status": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "educational_hash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{16}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id",
          "format",
          "channel",
          "status",
          "source_object_version",
          "language"
        ],
        "properties": {
          "variant_id": {
            "type": "string"
          },
          "format": {
            "type": "string",
            "enum": [
              "lesson",
              "video",
              "audio",
              "slides",
              "infographic",
              "flashcards",
              "quiz",
              "story",
              "branching_scenario",
              "game",
              "musical_mnemonic",
              "transcript",
              "image",
              "pdf",
              "pptx"
            ]
          },
          "channel": {
            "type": "string",
            "enum": [
              "public_social",
              "public_web",
              "email_opt_in",
              "private_workspace",
              "controlled_pilot"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "idea",
              "draft",
              "review",
              "approved",
              "released",
              "blocked",
              "superseded"
            ]
          },
          "source_object_version": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "file_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "transcript_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "captions_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "alt_text_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "estimated_duration_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "is_optional": {
            "type": "boolean"
          },
          "accessibility_alternative_variant_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "educational_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          },
          "media_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_version": {
            "type": "string",
            "minLength": 1
          },
          "source_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "asset_id",
              "course_id",
              "objective_id",
              "educational_hash",
              "source_id",
              "source_version",
              "source_digest",
              "media_digest"
            ],
            "properties": {
              "asset_id": {
                "type": "string",
                "minLength": 1
              },
              "course_id": {
                "type": "string",
                "minLength": 1
              },
              "objective_id": {
                "type": "string",
                "minLength": 1
              },
              "educational_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{16}$"
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "source_version": {
                "type": "string",
                "minLength": 1
              },
              "source_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "media_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "released"
                }
              }
            },
            "then": {
              "required": [
                "educational_hash",
                "media_digest",
                "source_id",
                "source_version",
                "source_digest",
                "approval"
              ]
            }
          }
        ]
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "kind",
          "answer_review_status"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "retrieval",
              "explanation",
              "application",
              "transfer",
              "reflection"
            ]
          },
          "answer_review_status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "scoring_rubric_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "recommended_next_object_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "analytics_permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "learner_consented": {
          "type": "boolean"
        },
        "record_aggregate_outcomes": {
          "type": "boolean"
        },
        "record_personal_responses": {
          "type": "boolean"
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "released"
          }
        }
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "educational_hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{16}$"
              },
              "subject_status": {
                "const": "approved"
              },
              "media_status": {
                "const": "approved"
              },
              "accessibility_status": {
                "const": "approved"
              },
              "rights_status": {
                "const": "approved"
              }
            }
          }
        }
      }
    }
  ]
}
