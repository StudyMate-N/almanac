/**
 * Carry review approvals over for items whose text is unchanged but whose
 * placement moved (lessonId/topic), e.g. after the course-standard-v1
 * restructure. Writes guarded, idempotent SQL: an approval is only replaced
 * when the stored hash is still exactly the approved version from the old
 * build, and every change is logged in app.review_log.
 *
 *   npx tsx --tsconfig tsconfig.json scripts/carry-over-approvals.mts <old-checkout> [--with-edition] > out.sql
 *
 * --with-edition also carries items whose only other change is `source`
 * (the textbook citation). Pages, images and anything reworded are never
 * carried: they go to the nurse reviewer.
 */
import { pathToFileURL } from "node:url";
import { resolve } from "node:path";

const [oldRoot, flag] = process.argv.slice(2);
if (!oldRoot) throw new Error("usage: carry-over-approvals.mts <old-checkout> [--with-edition]");
const load = async (r: string) => (await import(pathToFileURL(resolve(r, "src/content/course.ts")).href)).reviewables as { id: string; kind: string; item: Record<string, unknown> }[];
const { contentHash } = await import(pathToFileURL(resolve("src/lib/hash.ts")).href);
const placement = ["lessonId", "topic", ...(flag === "--with-edition" ? ["source"] : [])];
const strip = (o: Record<string, unknown>) => Object.fromEntries(Object.entries(o).filter(([k]) => !placement.includes(k)));

const now = await load(".");
const before = new Map((await load(oldRoot)).map((r) => [r.id, r]));
const rows: string[] = [];
for (const r of now) {
  const o = before.get(r.id);
  if (!o || (r.kind !== "question" && r.kind !== "card")) continue;
  const oldHash = contentHash(o.item);
  const newHash = contentHash(r.item);
  if (oldHash !== newHash && contentHash(strip(o.item)) === contentHash(strip(r.item))) rows.push(`('${r.id}','${oldHash}','${newHash}')`);
}
const note = `Carried over: text unchanged, moved in the topic restructure${flag === "--with-edition" ? " (citation updated)" : ""}`;
console.log(`-- ${rows.length} items. Generated by scripts/carry-over-approvals.mts. Run once, right after the deploy.
begin;
with v(item_id, old_hash, new_hash) as (values
  ${rows.join(",\n  ")}
), moved as (
  update app.reviews r set content_hash = v.new_hash, reviewed_at = now(), note = '${note}', reviewer = r.reviewer || ' (carry-over)'
  from v where r.item_id = v.item_id and r.status = 'approved' and r.content_hash = v.old_hash
  returning r.item_id, r.content_hash, r.reviewer
)
insert into app.review_log(item_id, content_hash, status, note, reviewer)
select item_id, content_hash, 'approved', '${note}', reviewer from moved;
commit;`);
